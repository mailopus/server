// A Mailopus server in your own Cloudflare account. Deploy with the Deploy to Cloudflare button or
// `pnpm run deploy` (README.md). Resource ids are left out on purpose: the first deploy creates the
// D1 database, R2 bucket and queue.
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "mailopus",
	"main": "./.output/server/index.mjs",
	// The Worker's own URL is what your _mailopus TXT record names. Add a custom domain if you prefer.
	"workers_dev": true,
	"preview_urls": false,
	"vars": {
		// The UI. Passkeys are made there and verified here, so these two go together.
		"APP_ORIGIN": "https://app.mailopus.net",
		"RP_ID": "mailopus.net"
		// With an IMAP proxy (imap/README.md), add IMAP_HOST and SMTP_HOST so Settings can show them.
	},
	// Pre-auth endpoints only (sign-in, first-run claim). 20 requests a minute per IP.
	"ratelimits": [{ "name": "AUTH_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	"d1_databases": [{ "binding": "DB", "database_name": "mailopus" }],
	"durable_objects": { "bindings": [{ "name": "ACCOUNT", "class_name": "Account" }] },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["Account"] }],
	// Outbound mail through Email Sending. EmailSubmission/set only sends From an identity in D1.
	"send_email": [{ "name": "EMAIL" }],
	// Gmail import: one queue message per page, so jobs run side by side and each page_token advances in order.
	"queues": {
		"producers": [{ "binding": "IMPORT_QUEUE", "queue": "mailopus-import" }],
		"consumers": [{ "queue": "mailopus-import", "max_batch_size": 1, "max_concurrency": 4, "max_retries": 10 }]
	},
	"triggers": { "crons": ["*/5 * * * *"] },
	"r2_buckets": [{ "binding": "MAIL", "bucket_name": "mailopus-mail" }]
}

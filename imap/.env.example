# Your Mailopus Worker's origin. One proxy serves one server. A local Worker from Docker Desktop:
#   MAILOPUS_URL=http://host.docker.internal:8787
MAILOPUS_URL=https://mailopus.<your subdomain>.workers.dev

# self-signed (laptop testing), acme (Let's Encrypt by DNS-01 through Cloudflare), or files.
TLS_MODE=self-signed
TLS_HOSTNAMES=imap.example.com,smtp.example.com
SMTP_HOSTNAME=smtp.example.com

# acme only. A Cloudflare API token with Zone > DNS > Edit on your domain's zone, nothing else.
# CF_API_TOKEN=
# ACME_EMAIL=

# files only.
# TLS_CERT=/data/certs/fullchain.pem
# TLS_KEY=/data/certs/privkey.pem

# Host side of the port mappings in compose.yaml. On a server: IMAP_BIND to its address, ports 993/143/465/587.
# IMAP_BIND=127.0.0.1
# IMAP_PORT=1993
# IMAP_STARTTLS_PORT=1143
# SMTPS_PORT=1465
# SUBMISSION_PORT=1587
